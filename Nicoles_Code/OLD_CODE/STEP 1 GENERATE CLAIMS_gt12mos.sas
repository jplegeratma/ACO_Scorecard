%MACRO FIRST_RUN ; 
OPTIONS MLOGIC MPRINT SYMBOLGEN ; 

%MACRO BASICS ; 
DATA MONTHS ; 
FORMAT STARTON ENDON MMDDYY10. RPT_DATE $9. ; 
  STARTON = INPUT("01&MONSTRT.&YEARSTRT",ANYDTDTE15. ) ; /* THE START DATE FROM THE MACRO */
  ENDON = INTNX('MONTH', STARTON,16)-1 ; /* THE END DATE 16 month period*/
  MONY = "'"||PUT(STARTON,YYMMDDN8.)||"'" ;  /* THIS IS THE START DATE FORMATTED */ 
  ASOF = "'"||PUT(TODAY(),YYMMDDN8.)||"'" ;  /* THIS IS THE AS OF DATE, WHICH IS THE DATE THE JOB WAS RUN */
  MMM1 = STRIP(PUT(STARTON,MONYY7.)) ; /*MMMYYYY FOR START DATE */
  MMM2 = STRIP(PUT(INTNX('MONTH', STARTON,16)-1,MONYY7.)) ; /*MMMYYYY FOR END DATE*/ /* 16 month period*/
  RPT_DATE = TRIM(SUBSTR(ASOF,2,4)||'_'||SUBSTR(ASOF,6,4)) ; 
  TITLE = "FROM "||MMM1||" through "||MMM2 ; 
  CALL SYMPUT ('STARTCHCK',UPCASE(PUT(STARTON,WORDDATE15.))) ; 
  CALL SYMPUT ('ENDCHCK',UPCASE(PUT(ENDON,WORDDATE15.))) ; 
  CALL SYMPUT ('MONYY',COMPRESS(MMM1||'_'||MMM2,' ')) ; /* THIS IS FOR THE FILE NAME LATER */
  CALL SYMPUT ('FLDR',RPT_DATE) ; /* FOR THE FOLDER NAME */
  CALL SYMPUT ('DTRNG',TITLE) ; /* FOR THE REPORT TITLES */
  CALL SYMPUT ('ASOF', ASOF) ; /* THE AS OF DATE */
RUN ; 

  %IF &STARTCHCK = . %THEN %DO ; 
	  %window NODATE IROW = 0 ROWS = 150 ICOLUMN = 0 COLUMNS = 125 COLOR = RED
		   #20 @15 'OOPS! IT LOOKS LIKE THE DATE IS A PROBLEM, TRY ENTERING THE DATE AGAIN' C = WHITE 
		   ; 
	 %display NODATE ;

	%DISPLAY COMPO ; 

DATA MONTHS ; 

FORMAT STARTON ENDON MMDDYY10. RPT_DATE $9. ; 
  STARTON = INPUT("01&MONSTRT.&YEARSTRT",ANYDTDTE15. ) ; /* THE START DATE FROM THE MACRO */
  ENDON = INTNX('MONTH', STARTON,16)-1 ; /* THE END DATE 16 month test period*/
  MONY = "'"||PUT(STARTON,YYMMDDN8.)||"'" ;  /* THIS IS THE START DATE FORMATTED */ 
  ASOF = "'"||PUT(TODAY(),YYMMDDN8.)||"'" ;  /* THIS IS THE AS OF DATE, WHICH IS THE DATE THE JOB WAS RUN */
  MMM1 = STRIP(PUT(STARTON,MONYY7.)) ; /*MMMYYYY FOR START DATE */
  MMM2 = STRIP(PUT(INTNX('MONTH', STARTON,16)-1,MONYY7.)) ; /*MMMYYYY FOR END DATE 16 month period*/
  RPT_DATE = TRIM(SUBSTR(ASOF,2,4)||'_'||SUBSTR(ASOF,6,4)) ; 
  TITLE = "FROM "||MMM1||" through "||MMM2 ; 
  CALL SYMPUT ('STARTCHCK',UPCASE(PUT(STARTON,WORDDATE15.))) ; 
  CALL SYMPUT ('ENDCHCK',UPCASE(PUT(ENDON,WORDDATE15.))) ; 
  CALL SYMPUT ('MONYY',COMPRESS(MMM1||'_'||MMM2,' ')) ; /* THIS IS FOR THE FILE NAME LATER */
  CALL SYMPUT ('FLDR',RPT_DATE) ; /* FOR THE FOLDER NAME */
  CALL SYMPUT ('DTRNG',TITLE) ; /* FOR THE REPORT TITLES */
  CALL SYMPUT ('ASOF', ASOF) ; /* THE AS OF DATE */
RUN ; 

%END ; 

  %IF &STARTCHCK > 1 %THEN %DO ; 
	  %window STARTDATE IROW = 0 ROWS = 150 ICOLUMN = 0 COLUMNS = 125 COLOR = GREEN 
		   #10 @15 "THE START DATE IS FOR THIS REPORT IS &STARTCHCK. " C = WHITE 
		   #14 @15 "THE END DATE IS FOR THIS REPORT IS &ENDCHCK. " C = YELLOW
		   #18 @15 "THE AS OF DATE IS FOR THIS REPORT IS &ASOF. " C = YELLOW
		   ; 
	 %display STARTDATE ;
  %END ; 

%MEND BASICS ; 

%BASICS ; 

%MACRO MAINFOLDER ( PATH ) ;
 DATA _NULL_ ;
   LENGTH PATH   $ 500
       FOLDER $ 100     ;

   PATH = SCAN( "&Path." , 1 , "\" ) ;
   DO _N_ = 2 TO COUNTC( "&Path." , "\" ) + 1 ;
       FOLDER = SCAN( "&Path." , _N_ , "\" ) ;
       RC = DCREATE( FOLDER , PATH ) ;
       PATH = CATS( PATH , "\" , FOLDER ) ;
       IF RC NE " " THEN PUT RC= ;
    END ;

 RUN ;

%MEND MAINFOLDER ;

