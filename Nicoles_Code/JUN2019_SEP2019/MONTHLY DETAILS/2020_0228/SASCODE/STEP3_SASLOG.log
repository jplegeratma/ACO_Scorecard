103  proc sql;
104  create table report_step2 as
105  select query_month, month_service, measure, claimtype, plan, aco,
105! claim_count, actual
106  from
107  (
108  select rpt1.*,
109  case when measure ='PCT_ID_MEDICAID' or measure ='PCT_DOS_FROM' or measure
109! ='PCT_DOS_THRU' or
110            measure ='PCT_SERV_PROV_ID' or measure ='PCT_SERV_PROV_ID_TYP' or
110!  measure ='PCT_SERV_PROV_TYP' or
111            measure ='PCT_SERV_PROV_SPEC' or measure ='PCT_BILL_PROV_ID' or
111! measure ='PCT_BILL_PROV_ID_TYP' or
112            measure='PCT_SVC_CAT' or measure='PCT_CLAIMCAT' or
113            measure='PCT_RECIND' or measure='PCT_AMTBILL' or
113! measure='PCT_AMTALLOW' or measure='PCT_AMTPAY' or
114            measure='PCT_PAID_DT' or measure='PCT_SERV_ID_LOC' or
114! measure='PCT_BILL_ID_LOC' or measure='PCT_TPL' or
115            measure='PCT_COPAY' or measure='PCT_COINS' or
115! measure='PCT_CLMDISP' or measure='PCT_CLMNUM' or
116            measure='PCT_CLMSUF' or measure='PCT_NUMLOGCLM' or
116! measure='PCT_ACO'
117            then TOT_RECORDS
118  when measure='PCT_PRESCRIBE_PROV_ID' or measure='PCT_PRES_PROV_ID_TYP' or
118! measure='PCT_SCRIPT_WRITTEN' or
119       measure='PCT_REFILL' or measure='PCT_DISPENSE' or measure='PCT_SCRIPT'
119!  or measure='PCT_FEE' or
120       measure='PCT_PRS_ID_LOC' then TOT_PHARM_SCRIPT
121  when measure='PCT_NDC' then TOT_PHARMSCRIPT_NOTCOMP
122  when measure='PCT_QTY_UNIT_BILL' then TOT_NONPHARM
123  when measure='PCT_PRIMARY_DIAG' or measure='PCT_SERV_NPI' or
123! measure='PCT_BILL_NPI' then TOT_NON_PHRM_DENTQ2
124  when measure='PCT_ADMITDT' or measure='PCT_ADMIT_TYPE' or
124! measure='PCT_ADMIT_SOURCE' then TOT_INPT_LTC
125  when measure='PCT_PRIMARY_DIAG' then TOT_NON_PHRM_DENTQ2
126  when measure='PCT_ICD_VERSION' then TOT_INP_OP_LTC_M_EXCQ2
127  when measure='PCT_PROC_CODE_M' then TOT_MEDQ2
128  when measure='PCT_PROC_CODE_O_D' then TOT_OUTPTQ2
129  when measure='PCT_PROC_MOD_DME' then TOT_MOD_DME
130  when measure='PCT_PROC_MOD_LABXRAY' then TOT_MOD_LABXRAY
131  when measure='PCT_PROC_MOD_SURGERYM' then TOT_MOD_SURGERYM
132  when measure='PCT_POS_CODE' or measure='PCT_POS_TYPE' then
132! TOT_NON_PHRM_DENT
133  when measure='PCT_REV_CODE' then TOT_INOUTLTC_NOART
134  when measure='PCT_PATIENT_STATUS' then TOT_INPT_OUTPT
135  when measure='PCT_DIAG_ADMIT' then TOT_INPAT_FILTER2
136  when measure='PCT_DISCHARGEDT' then TOT_INPAT_FILTER1
137  end as claim_count
138  from report_step1 rpt1
139  inner join (select cde_enc_mco, dos_yrmonth, aco, TOT_INPAT, TOT_PHARM,
139! TOT_OUTPT, TOT_OUTPTQ2, TOT_DENT, TOT_DENTQ2,
140                     TOT_MED, TOT_MEDQ2, TOT_NON_PHRM_DENTQ2,
140! TOT_PHARM_SCRIPT, TOT_INPT_LTC,
141                     TOT_INPT_OUTPT_LTC, TOT_INP_OP_LTC_M_EXCQ2,
141! TOT_NON_PHRM_DENT,
142                     TOT_INPAT_FILTER1, TOT_INPAT_FILTER2, TOT_MOD_DME,
142! TOT_MOD_LABXRAY,
143                     TOT_MOD_SURGERYM, TOT_INOUTLTC_NOART, TOT_INPT_OUTPT,
143! TOT_PHARMSCRIPT_NOTCOMP,TOT_NONPHARM,
144                     TOT_RECORDS
145              from mco_mbh_ptpdos_&TF.
146              /*where cde_enc_mco='BMC'*/)rpt2
147  on rpt1.plan=rpt2.cde_enc_mco and rpt1.month_service=rpt2.dos_yrmonth and
147! rpt1.aco=rpt2.aco);
NOTE: A CASE expression has no ELSE clause. Cases not accounted for by the WHEN
      clauses will result in a missing value for the CASE expression.
