48   proc sql;
49   create table report_step1 as
50   select
51   '2020-02' as query_month, /*UPDATE*/
52   dos_yrmonth as month_service,
53   measure,
54   case when measure ='PCT_ID_MEDICAID' or measure ='PCT_DOS_FROM' or measure
54 ! ='PCT_DOS_THRU' or
55             measure ='PCT_SERV_PROV_ID' or measure ='PCT_SERV_PROV_ID_TYP' or
55 !  measure ='PCT_SERV_PROV_TYP' or
56             measure ='PCT_SERV_PROV_SPEC' or measure ='PCT_BILL_PROV_ID' or
56 ! measure ='PCT_BILL_PROV_ID_TYP' or
57             measure='PCT_SVC_CAT' or measure='PCT_CLAIMCAT' or
58             measure='PCT_RECIND' or measure='PCT_AMTBILL' or
58 ! measure='PCT_AMTALLOW' or measure='PCT_AMTPAY' or
59             measure='PCT_PAID_DT' or measure='PCT_SERV_ID_LOC' or
59 ! measure='PCT_BILL_ID_LOC' or measure='PCT_TPL' or
60             measure='PCT_COPAY' or measure='PCT_COINS' or
60 ! measure='PCT_CLMDISP' or measure='PCT_CLMNUM' or
61             measure='PCT_CLMSUF' or measure='PCT_NUMLOGCLM' or
61 ! measure='PCT_ACO'
62        then 'All Claim Types'
63
64        when measure='PCT_QTY_UNIT_BILL' then 'Non Pharmacy'
65
66        when measure='PCT_PRESCRIBE_PROV_ID' or measure='PCT_PRES_PROV_ID_TYP'
66 !  or measure='PCT_SCRIPT_WRITTEN' or
67             measure='PCT_REFILL' or measure='PCT_DISPENSE' or
67 ! measure='PCT_SCRIPT' or measure='PCT_FEE' or
68             measure='PCT_PRS_ID_LOC'
69        then 'Pharmacy (prescriptions only, not OTC)'
70
71        when measure='PCT_NDC' then 'Pharmacy (prescriptions only, not OTC and
71 !  not compounded)'
72
73        when measure='PCT_PRIMARY_DIAG' or measure='PCT_ICD_VERSION' or
73 ! measure='PCT_POS_CODE' or
74             measure='PCT_POS_TYPE' or measure='PCT_SERV_NPI' or
74 ! measure='PCT_BILL_NPI'
75        then 'Inpatient, Outpatient, Professional, and LTC'
76
77        when measure='PCT_PROC_CODE_O_D' then 'Outpatient'
78
79        when measure='PCT_PROC_CODE_M' or measure='PCT_PROC_MOD_LABXRAY' or
79 ! measure='PCT_PROC_MOD_SURGERYM'
80        then 'Professional'
81
82        when measure='PCT_PROC_MOD_DME' then 'Professional
82 ! (modifier=RR,NU,UE)'
83
84        when measure='PCT_ADMITDT' or measure='PCT_ADMIT_TYPE' or
84 ! measure='PCT_ADMIT_SOURCE' then 'Inpatient and LTC'
85
86        when measure='PCT_DISCHARGEDT' or measure='PCT_DIAG_ADMIT' then
86 ! 'Inpatient'
87
88        when measure='PCT_PATIENT_STATUS' then 'Inpatient and Outpatient'
89
90        when measure='PCT_REV_CODE' then 'Inpatient, Outpatient, and LTC'
91   end as claimtype,
92   cde_enc_mco as plan,
93   ROUND((actual)*100,.01) as actual /*converting rate to a percent and
93 ! rounding 2 decimal places*/
94   from mco_mbh_pctdos_&TF._t;
NOTE: A CASE expression has no ELSE clause. Cases not accounted for by the WHEN
      clauses will result in a missing value for the CASE expression.
