49   proc sql;
50   create table report_step1 as
51   select
52   '2020-02' as query_month, /*UPDATE*/
53   dos_yrmonth as month_service,
54   measure,
55   case when measure ='PCT_ID_MEDICAID' or measure ='PCT_DOS_FROM' or measure
55 ! ='PCT_DOS_THRU' or
56             measure ='PCT_SERV_PROV_ID' or measure ='PCT_SERV_PROV_ID_TYP' or
56 !  measure ='PCT_SERV_PROV_TYP' or
57             measure ='PCT_SERV_PROV_SPEC' or measure ='PCT_BILL_PROV_ID' or
57 ! measure ='PCT_BILL_PROV_ID_TYP' or
58             measure='PCT_SVC_CAT' or measure='PCT_CLAIMCAT' or
59             measure='PCT_RECIND' or measure='PCT_AMTBILL' or
59 ! measure='PCT_AMTALLOW' or measure='PCT_AMTPAY' or
60             measure='PCT_PAID_DT' or measure='PCT_SERV_ID_LOC' or
60 ! measure='PCT_BILL_ID_LOC' or measure='PCT_TPL' or
61             measure='PCT_COPAY' or measure='PCT_COINS' or
61 ! measure='PCT_CLMDISP' or measure='PCT_CLMNUM' or
62             measure='PCT_CLMSUF' or measure='PCT_NUMLOGCLM' or
62 ! measure='PCT_ACO'
63        then 'All Claim Types'
64
65        when measure='PCT_QTY_UNIT_BILL' then 'Non Pharmacy'
66
67        when measure='PCT_PRESCRIBE_PROV_ID' or measure='PCT_PRES_PROV_ID_TYP'
67 !  or measure='PCT_SCRIPT_WRITTEN' or
68             measure='PCT_REFILL' or measure='PCT_DISPENSE' or
68 ! measure='PCT_SCRIPT' or measure='PCT_FEE' or
69             measure='PCT_PRS_ID_LOC'
70        then 'Pharmacy (prescriptions only, not OTC)'
71
72        when measure='PCT_NDC' then 'Pharmacy (prescriptions only, not OTC and
72 !  not compounded)'
73
74        when measure='PCT_PRIMARY_DIAG' or measure='PCT_ICD_VERSION' or
74 ! measure='PCT_POS_CODE' or
75             measure='PCT_POS_TYPE' or measure='PCT_SERV_NPI' or
75 ! measure='PCT_BILL_NPI'
76        then 'Inpatient, Outpatient, Professional, and LTC'
77
78        when measure='PCT_PROC_CODE_O_D' then 'Outpatient'
79
80        when measure='PCT_PROC_CODE_M' or measure='PCT_PROC_MOD_LABXRAY' or
80 ! measure='PCT_PROC_MOD_SURGERYM'
81        then 'Professional'
82
83        when measure='PCT_PROC_MOD_DME' then 'Professional
83 ! (modifier=RR,NU,UE)'
84
85        when measure='PCT_ADMITDT' or measure='PCT_ADMIT_TYPE' or
85 ! measure='PCT_ADMIT_SOURCE' then 'Inpatient and LTC'
86
87        when measure='PCT_DISCHARGEDT' or measure='PCT_DIAG_ADMIT' then
87 ! 'Inpatient'
88
89        when measure='PCT_PATIENT_STATUS' then 'Inpatient and Outpatient'
90
91        when measure='PCT_REV_CODE' then 'Inpatient, Outpatient, and LTC'
92   end as claimtype,
93
94   cde_enc_mco as plan,
95   aco,
96   ROUND((actual)*100,.01) as actual /*converting rate to a percent and
96 ! rounding 2 decimal places*/
97   from mco_mbh_ptpdos_&TF._t;
NOTE: A CASE expression has no ELSE clause. Cases not accounted for by the WHEN
      clauses will result in a missing value for the CASE expression.
