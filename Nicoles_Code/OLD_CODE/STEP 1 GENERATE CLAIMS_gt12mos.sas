%MACRO ENDER (MONS,ASOFDT);  
DATA _NULL_ ; 
  FILE MOPS MOD; 
PUT @ 10 "WHERE  ENC.DOS_FROM_DT BETWEEN TO_DATE(&MONS.,'YYYYMMDD') " ;
PUT @ 10 "        AND ((TO_DATE(&MONS., 'YYYYMMDD') + INTERVAL '16' MONTH ) -1)" ; 
PUT @ 10 "AND  ENC.REMIT_THRU_DT = TO_DATE('99991231','YYYYMMDD')   " ; 
PUT @ 10 "AND TO_DATE(&ASOFDT.,'YYYYMMDD') BETWEEN ENC.WH_FROM_DT AND ENC.WH_THRU_DT   " ; 
PUT @ 10 "AND ENC.CDE_CLM_DISPOSITION <> 'V' ";
PUT @ 10 "AND ENC.IND_OFFSET = 'N' ";
PUT @ 10 "AND ENC.CDE_ENC_MCO IN('BMC','CHA','FLN','NHP','HNE','MBH')  " ; 
PUT '       ) BY ORACLE; DISCONNECT FROM ORACLE; QUIT; ' ; 
RUN ; 
%MEND ENDER ; 

%MACRO RUNNER (MON) ; 
 
%INCLUDE "W:\APPLICATION ANALYSIS\MCO and MBHP Evaluation Scorecard\&MONYY.\MONTHLY DETAILS\&FLDR.\SASCODE\SQL CODE FOR DOS &MON..TXT" ; 

%MEND RUNNER ; 

/* NOW PROCESS THE DATA INTO ONE TEXT FILE AND RUN THAT FILE TO EXECUTE THE SQL PROCESS */
DATA _NULL_ ; 
  SET MONTHS ; 
  CALL EXECUTE ('%OPENER (MON='||COMPRESS(MMM1||'_'||MMM2,' ')||')') ;
  CALL EXECUTE ('%MIDDER') ; 
  CALL EXECUTE ('%ENDER  (MONS='||MONY||',ASOFDT='||ASOF||')') ; 
  CALL EXECUTE ('%RUNNER  (MON='||COMPRESS(MMM1||'_'||MMM2,' ')||')') ; /* RUN THE JOB TO CREATE THE DATASET */ 
RUN; 

PROC PRINTTO ; RUN ; 

/* ASSIGN THE LIBNAME FOR THE DATA WAREHOUSE */
LIBNAME NW ORACLE PATH=DWP1RAC SCHEMA=&UID DBPROMPT=NO DEFER=NO USER=&UID PASSWORD=&PWRD;

/* CHECK TO SEE IF THE FIRST PROCESS COMPLETED, AND IF THE TABLE EXISTS*/
		%IF %SYSFUNC(EXIST(NW.MCO_MBHP_DOS_&MONYY)) = 1 %THEN %DO ; /* DO 1 */
			%PUT THE TABLE NW.MCO_MBHP_DOS_&MONYY. EXISTS ; 

			PROC SQL ; 
			SELECT COUNT(*) INTO :OBREX 
			FROM NW.MCO_MBHP_DOS_&MONYY. ; 
			QUIT ; 
		%END ;  /* END 1 */

%PUT THE NUMBER OF RECORDS IN THE TABLE IS &OBREX. ; 

%IF %SYSFUNC(EXIST(NW.MCO_MBHP_DOS_&MONYY.)) < 1 %THEN %GOTO NOWT ; 
%IF &OBREX < 1 %THEN %GOTO NOWT ; 

%NOWT: 

%IF &OBREX < 1 %THEN %DO ; 

    DATA NOSPACE ; 
      INFILE OUTLOG TRUNCOVER ; 
	INPUT @01 TEXT $6. @; 
	  IF TEXT = 'ERROR:' THEN INPUT @ 01 REASON $81. /
										@ 08 REASON2 $18. ;
        COMBO = REASON||REASON2 ; 
        IF TEXT = 'ERROR:' THEN CALL SYMPUT('ERRX',COMBO) ; 
        IF TEXT = 'ERROR:' ; 
   RUN ; 

			PROC SQL ; 
			SELECT COUNT(*) INTO :NOFILEREX 
			FROM NOSPACE  ; 
			QUIT ; 

%IF &NOFILEREX > 0 %THEN %DO ; 

%window NOCLMS IROW = 0 ROWS = 150 ICOLUMN = 0 COLUMNS = 125 COLOR = BLACK

            #14 @20 'NOTE: THE CLAIMS DATA WAS NOT CREATED FOR THE FOLLOWING REASON:' attr = underline COLOR = WHITE 
            #18 @05 "&ERRX." attr = underline COLOR = PINK 
            #28 @20  "PRESS ENTER TO CONCLUDE " COLOR = WHITE 
        ;
    %display NOCLMS ;

%END ; 

%IF &NOFILEREX = 0 %THEN %DO ; 

%window NOCLMS IROW = 0 ROWS = 150 ICOLUMN = 0 COLUMNS = 125 COLOR = BLACK

            #14 @20 'NOTE: THE CLAIMS DATA WAS NOT CREATED, PLEASE CHECK THE LOG TO SEE WHY' attr = underline COLOR = WHITE 
            #28 @20  "PRESS ENTER TO CONCLUDE " COLOR = WHITE 
        ;
    %display NOCLMS ;

%END ; 

%END ; 

%END ; 

%IF &OBREX > 0 %THEN %DO ; 

    %window YESCLMS IROW = 0 ROWS = 150 ICOLUMN = 0 COLUMNS = 125 COLOR = GREEN 

            #14 @20 'NOTE: THE CLAIMS DATA WAS CREATED' ATTR = UNDERLINE COLOR = WHITE 
            #18 @20 "AND HAS A TOTAL OF &OBREX. RECORDS" ATTR = UNDERLINE COLOR = WHITE 
            #32 @25  "PRESS ENTER TO CONCLUDE THIS PHASE" COLOR = WHITE 
        ;
    %display YESCLMS ;
%END ; 


%MEND FIRST_RUN ; 

