100  proc sql;
101  create table report_step2 as
102  select query_month, month_service, measure, claimtype, plan, claim_count,
102! actual
103  from
104  (
105  select rpt1.*,
106  case when measure ='PCT_ID_MEDICAID' or measure ='PCT_DOS_FROM' or measure
106! ='PCT_DOS_THRU' or
107            measure ='PCT_SERV_PROV_ID' or measure ='PCT_SERV_PROV_ID_TYP' or
107!  measure ='PCT_SERV_PROV_TYP' or
108            measure ='PCT_SERV_PROV_SPEC' or measure ='PCT_BILL_PROV_ID' or
108! measure ='PCT_BILL_PROV_ID_TYP' or
109            measure='PCT_SVC_CAT' or measure='PCT_CLAIMCAT' or
110            measure='PCT_RECIND' or measure='PCT_AMTBILL' or
110! measure='PCT_AMTALLOW' or measure='PCT_AMTPAY' or
111            measure='PCT_PAID_DT' or measure='PCT_SERV_ID_LOC' or
111! measure='PCT_BILL_ID_LOC' or measure='PCT_TPL' or
112            measure='PCT_COPAY' or measure='PCT_COINS' or
112! measure='PCT_CLMDISP' or measure='PCT_CLMNUM' or
113            measure='PCT_CLMSUF' or measure='PCT_NUMLOGCLM' or
113! measure='PCT_ACO'
114            then TOT_RECORDS
115  when measure='PCT_PRESCRIBE_PROV_ID' or measure='PCT_PRES_PROV_ID_TYP' or
115! measure='PCT_SCRIPT_WRITTEN' or
116       measure='PCT_REFILL' or measure='PCT_DISPENSE' or measure='PCT_SCRIPT'
116!  or measure='PCT_FEE' or
117       measure='PCT_PRS_ID_LOC' then TOT_PHARM_SCRIPT
118  when measure='PCT_NDC' then TOT_PHARMSCRIPT_NOTCOMP
119  when measure='PCT_QTY_UNIT_BILL' then TOT_NONPHARM
120  when measure='PCT_PRIMARY_DIAG' or measure='PCT_SERV_NPI' or
120! measure='PCT_BILL_NPI' then TOT_NON_PHRM_DENTQ2
121  when measure='PCT_ADMITDT' or measure='PCT_ADMIT_TYPE' or
121! measure='PCT_ADMIT_SOURCE' then TOT_INPT_LTC
122  when measure='PCT_PRIMARY_DIAG' then TOT_NON_PHRM_DENTQ2
123  when measure='PCT_ICD_VERSION' then TOT_INP_OP_LTC_M_EXCQ2
124  when measure='PCT_PROC_CODE_M' then TOT_MEDQ2
125  when measure='PCT_PROC_CODE_O_D' then TOT_OUTPTQ2
126  when measure='PCT_PROC_MOD_DME' then TOT_MOD_DME
127  when measure='PCT_PROC_MOD_LABXRAY' then TOT_MOD_LABXRAY
128  when measure='PCT_PROC_MOD_SURGERYM' then TOT_MOD_SURGERYM
129  when measure='PCT_POS_CODE' or measure='PCT_POS_TYPE' then
129! TOT_NON_PHRM_DENT
130  when measure='PCT_REV_CODE' then TOT_INOUTLTC_NOART
131  when measure='PCT_PATIENT_STATUS' then TOT_INPT_OUTPT
132  when measure='PCT_DIAG_ADMIT' then TOT_INPAT_FILTER2
133  when measure='PCT_DISCHARGEDT' then TOT_INPAT_FILTER1
134  end as claim_count
135  from report_step1 rpt1
136  inner join (select cde_enc_mco, dos_yrmonth, TOT_INPAT, TOT_PHARM,
136! TOT_OUTPT, TOT_OUTPTQ2, TOT_DENT, TOT_DENTQ2,
137                     TOT_MED, TOT_MEDQ2, TOT_NON_PHRM_DENTQ2,
137! TOT_PHARM_SCRIPT, TOT_INPT_LTC,
138                     TOT_INPT_OUTPT_LTC, TOT_INP_OP_LTC_M_EXCQ2,
138! TOT_NON_PHRM_DENT,
139                     TOT_INPAT_FILTER1, TOT_INPAT_FILTER2, TOT_MOD_DME,
139! TOT_MOD_LABXRAY,
140                     TOT_MOD_SURGERYM, TOT_INOUTLTC_NOART, TOT_INPT_OUTPT,
140! TOT_PHARMSCRIPT_NOTCOMP,TOT_NONPHARM,
141                     TOT_RECORDS
142              from mco_mbh_pctdos_&TF.
143              /*where cde_enc_mco='BMC'*/)rpt2
144  on rpt1.plan=rpt2.cde_enc_mco and rpt1.month_service=rpt2.dos_yrmonth);
NOTE: A CASE expression has no ELSE clause. Cases not accounted for by the WHEN
      clauses will result in a missing value for the CASE expression.
